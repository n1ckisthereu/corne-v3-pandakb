#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };

        togdance: togdance {
            compatible = "zmk,behavior-tap-dance";
            label = "TOGDANCE";
            #binding-cells = <0>;
            bindings = <&kp RETURN>, <&kp RETURN>, <&tog 3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 31>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };

        ToggleGaming {
            bindings = <&tog 5>;
            key-positions = <0 11>;
        };

        key_utils {
            bindings = <&tog 4>;
            key-positions = <12 23>;
        };

        dota {
            bindings = <&tog 6>;
            key-positions = <24 35>;
        };
    };

    macros {
        alt_1: alt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "ALT_1";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        root {
            bindings = <
&kp TAB                  &kp Q  &kp W  &kp E         &kp R        &kp T         &kp Y      &kp U        &kp I          &kp O    &kp P          &kp BSPC
&kp LCTRL                &kp A  &kp S  &kp D         &kp F        &kp G         &kp H      &kp J        &kp K          &kp L    &kp SEMICOLON  &kp SQT
&mt LEFT_SHIFT CAPSLOCK  &kp Z  &kp X  &kp C         &kp V        &kp B         &kp N      &kp M        &kp COMMA      &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
                                       &kp LEFT_GUI  &lt 1 SPACE  &kp LEFT_ALT  &togdance  &lt 2 SPACE  &kp RIGHT_ALT
            >;
        };

        numbers_symbols {
            bindings = <
&kp ESCAPE        &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT   &kp CARET       &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp DELETE
&kp LEFT_CONTROL  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp MINUS       &kp EQUAL      &kp GRAVE     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BACKSLASH
&kp RIGHT_SHIFT   &kp NUMBER_6     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp UNDERSCORE  &kp PLUS       &kp TILDE     &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE
                                                 &trans        &trans        &trans        &trans          &trans         &trans
            >;
        };

        extra {
            bindings = <
&kp ESC  &kp F1     &kp F2     &kp F3      &kp F4       &kp F5           &kp F6          &kp F7          &kp F8        &kp F9           &kp F10  &kp F11
&trans   &kp PG_UP  &trans     &trans      &kp END      &kp HOME         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans   &kp F12
&trans   &kp PG_DN  &kp K_CUT  &kp K_COPY  &kp K_PASTE  &kp PRINTSCREEN  &trans          &trans          &trans        &trans           &trans   &trans
                               &trans      &trans       &trans           &trans          &trans          &trans
            >;
        };

        colemak {
            bindings = <
&trans  &kp Q  &kp W  &kp F   &kp P   &kp G   &kp J   &kp L   &kp U      &kp Y       &kp SEMICOLON  &kp BACKSPACE
&trans  &kp A  &kp R  &kp S   &kp T   &kp D   &kp H   &kp N   &kp E      &kp I       &kp O          &kp SINGLE_QUOTE
&trans  &kp Z  &kp X  &kp C   &kp V   &kp B   &kp K   &kp M   &kp COMMA  &kp PERIOD  &kp FSLH       &trans
                      &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        keyboard_utils {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                      &kp C_MUTE  &kp C_PREV  &kp C_NEXT  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_PLAY_PAUSE
&bl BL_TOG  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_COLOR_HSB(331,90,48)  &trans      &trans      &trans      &trans             &trans           &trans
&trans      &trans           &trans           &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_COLOR_HSB(0,0,100)    &trans      &trans      &trans      &trans             &trans           &trans
                                              &trans           &trans           &trans                            &trans      &trans      &trans
            >;
        };

        Games {
            bindings = <
&trans          &trans  &trans  &trans  &trans     &trans        &trans  &trans  &trans                  &trans  &trans  &trans
&trans          &trans  &trans  &trans  &trans     &trans        &trans  &trans  &trans                  &trans  &trans  &trans
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans     &trans        &trans  &trans  &trans                  &trans  &trans  &trans
                                &mo 1   &kp SPACE  &kp LEFT_ALT  &trans  &trans  &mt RIGHT_ALT LEFT_WIN
            >;
        };

        dota {
            bindings = <
&trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &lt 2 EXCLAMATION  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
